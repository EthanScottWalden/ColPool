rules_version = '2';

// Default deny all. The client reads, the backend writes (ARCHITECTURE §3.4).
// Rules ship with the feature they protect (INTENT §1.3); this file is never
// loosened as scaffolding.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
