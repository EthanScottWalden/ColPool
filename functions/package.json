{
  "name": "colpool-functions",
  "version": "0.0.0",
  "private": true,
  "description": "ColPool Cloud Functions and emulator test harness",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.12.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "pretest": "npm run build && npm run typecheck",
    "test": "node scripts/emulator-env.mjs emulators:exec --only auth,firestore,functions --project demo-colpool \"node --test --test-concurrency=1 functions/test/*/*.test.ts\"",
    "emulators": "node scripts/emulator-env.mjs emulators:start --only auth,firestore,functions --project demo-colpool"
  },
  "dependencies": {
    "firebase-admin": "14.5.1",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "22.20.5",
    "firebase": "13.3.0",
    "firebase-tools": "15.36.0",
    "typescript": "7.0.2"
  }
}
