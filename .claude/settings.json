{
  "agent": "lead",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh project item-list *)",
      "Bash(gh project field-list *)",
      "Bash(node .claude/hooks/github.mjs *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(gh issue view *)",
      "PowerShell(gh issue list *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh pr diff *)",
      "PowerShell(gh project item-list *)",
      "PowerShell(gh project field-list *)"
    ],
    "deny": [
      "Read(**/local.properties)",
      "Read(**/secrets.properties)",
      "Read(**/google-services.json)",
      "Read(**/*service-account*.json)",
      "Read(**/*firebase-adminsdk*.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.runtimeconfig.json)",
      "Read(//mnt/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/configstore/**)",
      "Read(~/.git-credentials)",
      "Read(~/.bash_history)",
      "Bash(firebase deploy *)",
      "Bash(npx firebase deploy *)",
      "Bash(npm run deploy *)",
      "Bash(npm --prefix functions run deploy *)",
      "Bash(firebase functions:delete *)",
      "Bash(firebase firestore:delete *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin dev)",
      "Bash(git push origin staging)",
      "Bash(git push origin main)",
      "Bash(git push origin HEAD:dev)",
      "Bash(git push origin HEAD:staging)",
      "Bash(git push origin HEAD:main)",
      "PowerShell(firebase deploy *)",
      "PowerShell(npx firebase deploy *)",
      "PowerShell(npm run deploy *)",
      "PowerShell(npm --prefix functions run deploy *)",
      "PowerShell(firebase functions:delete *)",
      "PowerShell(firebase firestore:delete *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push --force-with-lease *)",
      "PowerShell(git push origin dev)",
      "PowerShell(git push origin staging)",
      "PowerShell(git push origin main)",
      "PowerShell(git push origin HEAD:dev)",
      "PowerShell(git push origin HEAD:staging)",
      "PowerShell(git push origin HEAD:main)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "node .claude/hooks/github.mjs *",
      "node .claude/skills/next-issue/scripts/next-issue.mjs *"
    ],
    "filesystem": {
      "denyRead": [
        "~",
        "~/.config/gh",
        "/mnt",
        "./.env",
        "./.env.local",
        "./functions/.env",
        "./functions/.env.local",
        "./android/.env"
      ],
      "allowRead": [
        ".",
        "~/.bashrc",
        "~/.profile",
        "~/.gitconfig",
        "~/.nvm",
        "~/.npm",
        "~/.cache",
        "~/.gradle",
        "~/.android",
        "~/Android"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "dl.google.com",
        "maven.google.com",
        "repo.maven.apache.org",
        "repo1.maven.org",
        "plugins.gradle.org",
        "plugins-artifacts.gradle.org",
        "services.gradle.org",
        "downloads.gradle.org",
        "firebase.google.com",
        "console.firebase.google.com",
        "developers.google.com",
        "developer.android.com",
        "kotlinlang.org",
        "claude.ai",
        "www.its.ucla.edu",
        "stars.aashe.org",
        "localhost",
        "127.0.0.1"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/gh-guard.mjs\" pre" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/gh-guard.mjs\" post" }
        ]
      }
    ]
  }
}
